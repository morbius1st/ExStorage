		<SolidColorBrush x:Key="test1" Color="LawnGreen" />

		<Style x:Key="lblTitle"
				TargetType="Label"
				>
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Margin" Value="5,0,0,2" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Content" Value="Title" />
		</Style>

		<Style x:Key="pathStyle"
				TargetType="Path"
				>
			<Setter Property="Margin" Value="4" />
			<Setter Property="Stretch" Value="Uniform" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Data" Value="{StaticResource Ic.ClearText}" />
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>

		<ContentControl x:Key="CC1"
				x:Shared="False"
				>
			<DockPanel
					Margin="0,0,0,5"
					Height="20"
					VerticalAlignment="Top"
					Background="{Binding RelativeSource={RelativeSource Self},
															 Path=(vx:VisualStatesAP.GenericBrushA)}"
					>

				<Label
						Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}},
																 Path=(vx:VisualStatesAP.GenericBrushB)}"
						Style="{StaticResource lblTitle}"
						/>

				<Path
						DockPanel.Dock="Right"
						Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}},
													 Path=(vx:VisualStatesAP.GenericBrushC)}"
						Style="{StaticResource pathStyle}"
						>

				</Path>

			</DockPanel>
		</ContentControl>


		<SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FFBEE6FD" />
		<SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1" />
		<SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6" />
		<SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4" />

		<SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B" />
		<SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5" />
		<SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383" />

		<ControlTemplate x:Key="ButtonTemplate1"
				TargetType="{x:Type ButtonBase}"
				>
			<Border x:Name="border"
					Background="{TemplateBinding Background}"
					BorderThickness="{TemplateBinding BorderThickness}"
					BorderBrush="{TemplateBinding BorderBrush}"
					SnapsToDevicePixels="true"
					>
				<ContentPresenter x:Name="contentPresenter"
						Margin="{TemplateBinding Padding}"
						HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
						VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
						Focusable="False"
						RecognizesAccessKey="True"
						SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
						/>
			</Border>
			<ControlTemplate.Triggers>
				<Trigger Property="Button.IsDefaulted" Value="true">
					<Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
				</Trigger>
				<!-- <Trigger Property="IsMouseOver" Value="true"> -->
				<!-- 	<Setter TargetName="border" Property="Background" Value="{StaticResource Button.MouseOver.Background}" /> -->
				<!-- 	<Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Button.MouseOver.Border}" /> -->
				<!-- </Trigger> -->
				<Trigger Property="IsPressed" Value="true">
					<!-- <Setter TargetName="border" Property="Background" Value="{StaticResource Button.Pressed.Background}" /> -->
					<Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Button.Pressed.Border}" />
				</Trigger>
				<Trigger Property="IsEnabled" Value="false">
					<!-- <Setter TargetName="border" Property="Background" Value="{StaticResource Button.Disabled.Background}" /> -->
					<Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Button.Disabled.Border}" />
					<Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{StaticResource Button.Disabled.Foreground}" />
				</Trigger>
			</ControlTemplate.Triggers>
		</ControlTemplate>

	</Window.Resources>

	<Border
			Background="#222222"
			BorderThickness="1"
			BorderBrush="Red"
			CornerRadius="8"
			>
		<!-- BorderBrush="DodgerBlue" -->


		<Grid Background="Transparent">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="120" />
				<ColumnDefinition Width="100" />
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="40" />
			</Grid.RowDefinitions>

			<Border
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					Background="{Binding Path=TitleBarBackground,
															 FallbackValue='Transparent'}"
					CornerRadius="8,8,0,0"
					>
				<DockPanel>


					<Button x:Name="BtnClose"
							Margin="0,4,6,3"
							Width="20"
							Height="20"
							Background="Transparent"
							BorderThickness="0"
							DockPanel.Dock="Right"
							Template="{DynamicResource ButtonTemplate1}"
							Click="BtnClose_OnClick"
							>
						<Button.Style>
							<Style TargetType="Button">
								<Setter Property="Background" Value="Transparent" />
								<Setter Property="ContentTemplate">
									<Setter.Value>
										<DataTemplate>
											<ContentControl>
												<ContentControl.Content>
													<Path
															DataContext="{Binding Path=DataContext,
																										RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
															Stretch="UniformToFill"
															Focusable="False"
															>
														<Path.Style>
															<Style TargetType="Path">
																<Setter Property="Data" Value="{StaticResource Ic.ClearText}" />
																<Setter Property="Fill" Value="{Binding Path=CloseButtonFill, FallbackValue='Lime'}" />
																<Style.Triggers>
																	<DataTrigger Value="true" Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=IsPressed}">
																		<Setter Property="Fill" Value="DarkRed" />
																	</DataTrigger>
																	<DataTrigger Value="false" Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=IsEnabled}">
																		<Setter Property="Fill" Value="#8a8a8a" />
																	</DataTrigger>
																	<DataTrigger Value="true" Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=IsMouseOver}">
																		<Setter Property="Fill" Value="White" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</Path.Style>
													</Path>
												</ContentControl.Content>
											</ContentControl>
										</DataTemplate>
									</Setter.Value>
								</Setter>

							</Style>
						</Button.Style>
					</Button>

					<Image
							Margin="7,3,0,2"
							Width="20"
							Height="20"
							Source="/ExStoreTest2025;component/Assets/CyberStudio Logo - Narrow.png"
							Stretch="Uniform"
							/>

					<Image
							Width="18"
							Height="18"
							Source="/ExStoreTest2025;component/Assets/CyberStudio Logo - Full v2.png"
							Stretch="Uniform"
							
							/>

					<Label
							Content="{Binding Path=TitleBarText,
																FallbackValue='TitleBarText'}"
							Margin="5,3,0,2"
							Padding="0"
							FontSize="14"
							Foreground="{Binding Path=TitleBarForeground,
																	 FallbackValue='White'}"
							DockPanel.Dock="Left"
							/>


				</DockPanel>
			</Border>


			<StackPanel
					Grid.Row="1"
					Grid.Column="1"
					VerticalAlignment="Top"
					Orientation="Vertical"
					>
				<Button x:Name="Btn_Write"
						Content="Write"
						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="Btn_Write_OnClick"
						/>

				<Button x:Name="Btn_Read"
						Content="Read"
						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="Btn_Read_OnClick"
						/>

				<Button x:Name="Btn_Delete"
						Content="Delete"
						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="Btn_Delete_OnClick"
						/>

				<Button x:Name="Btn_Find"
