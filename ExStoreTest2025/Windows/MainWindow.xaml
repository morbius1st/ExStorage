						Click="Btn_FindSchema_OnClick"
						/>

				<Button x:Name="Btn_EraseSchema"
						Content="Erase Schema"
						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="Btn_EraseSchema_OnClick"
						/>


				<Button x:Name="Btn_Test1"
						Content="Test1"
						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="Btn_Test1_OnClick"
						/>


				<Button x:Name="Btn_Test2"
						Content="Test1 (values)"
						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="Btn_Values_OnClick"
						/>

				<Button x:Name="Btn_Test3"
						Content="Test3 (chg values)"
						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="Btn_ChgValues_OnClick"
						/>


				<Button x:Name="BtnTitleBarTest1"
						Content="Test Title Bar 1"
						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="BtnTitleBarTest1_OnClick"
						/>

				<Button x:Name="BtnTitleBarTest2"
						Content="Test Title Bar 2"
						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="BtnTitleBarTest2_OnClick"
						/>

			</StackPanel>


			<Button x:Name="Btn_Exit"
					Grid.Row="2"
					Grid.Column="1"
					Content="Exit"
					Margin="5"
					Click="Btn_Exit_OnClick"
					/>

			<Button x:Name="Btn_Clear"
					Grid.Row="2"
					Grid.Column="0"
					Content="Clear Message"
					Margin="5"
					Width="120"
					HorizontalAlignment="Right"
					Click="Btn_Clear_OnClick"
					/>

			<TextBox
					Grid.Row="1"
					FontFamily="Consolas"
					FontSize="12"
					Background="Transparent"
					Foreground="White"
					Text="{Binding Path=Message}"
					VerticalScrollBarVisibility="Visible"
					HorizontalScrollBarVisibility="Visible"
					/>


			<StackPanel
					Grid.Row="1"
					Grid.Column="2"
					Margin="5"
					VerticalAlignment="Stretch"
					>
