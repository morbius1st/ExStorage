<Window x:Name="mainWin"
		x:Class="ExStoreTest2025.Windows.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:local="clr-namespace:ExStoreTest2025.Windows"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vx="clr-namespace:Windows.Support"
		Title="MainWindow"
		DataContext="{Binding RelativeSource={RelativeSource Self}}"
		WindowStyle="None"
		AllowsTransparency="True"
		Width="1200"
		Height="650"
		mc:Ignorable="d"
		Background="#00020202"
		ResizeMode="NoResize"
		Focusable="False"
		ShowInTaskbar="False"
		
		Activated="mainWin_Activated"

		MouseEnter="MainWindow_OnMouseEnter"
		MouseLeave="MainWindow_OnMouseLeave"
		MouseDown="MiniMain_OnMouseDown"
		MouseLeftButtonUp="Window_MouseLeftButtonUp"
		>

