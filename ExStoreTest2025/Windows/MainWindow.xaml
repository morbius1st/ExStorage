						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="Btn_FindDs_OnClick"
						/>

				<Button x:Name="Btn_Erase"
						Content="Erase Ds"
						Margin="5"
						Width="120"
						Height="26"
						VerticalAlignment="Top"
						Click="Btn_Erase_OnClick"
						/>

				<Button x:Name="Btn_FindSchema"
						Content="Find Schema"
						Margin="5"
