		}

		private bool wbkCanApply(bool result)
		{
			if (_wbk.ApplyBtnStatus)
			{
				R.WriteAnyway(" >> Can Apply - Continue >> ");
				return true;
			}

			R.WriteAnyway(" >> CANNOT APPLY - ABORT ");

			wbkShowTestCompletionResult(result);

			R.AddRouteExit("CANNOT APPLY - ABORT");

			return false;
		}

		private bool wbkCanUndo(bool result)
		{
			if (_wbk.UndoBtnStatus)
			{
				R.WriteAnyway(" >> Can Undo - Continue >> ");
				return true;
			}

			R.WriteAnyway(" >> CANNOT UNDO - ABORT ");

			wbkShowTestCompletionResult(result);

			R.AddRouteExit("CANNOT UNDO - ABORT");

			return false;
		}

		private bool wbkUndoSingle(FieldData<WorkBookFieldKeys> field)
		{
			string proc = "UNDO SINGLE";

			wbkBeginTest(proc);

			R.AddRouteEnter();
			R.WriteLine("begin undo change| undo single");

			_wbk.UndoChange(field, false);

			R.WriteLine("end undo change| undo single");
			R.AddRouteExit();

			wbkEndTest(proc);

			return endValidateTest2(proc);
		}

		private bool wbkApplySingle(FieldData<WorkBookFieldKeys> field)
		{
			string proc = "APPLY SINGLE";

			wbkBeginTest(proc);

			R.AddRouteEnter();
			R.WriteLine("begin apply change| apply single");

			_wbk.ApplyChange(field, false);

			R.WriteLine("end apply change| apply single");
			R.AddRouteExit();

			wbkEndTest(proc);

			return endValidateTest2(proc);
		}

		private bool wbkUndoAll()
		{
			string proc = "UNDO ALL";

			wbkBeginTest(proc);

			// _wbk.UndoChange(_wbk.DescField, false);
			_wbk.UndoChangesAll(ChgSrcId.CI_SRC_A);

			wbkEndTest(proc);

			return endValidateTest2(proc);
		}

		private bool wbkApplyAll()
		{
			string proc = "WORKBOOK APPLY ALL";

			wbkBeginTest(proc);

			_wbk.ApplyChangesAll();

			wbkEndTest(proc);

			return endValidateTest2(proc);
		}

		private bool xDAddSheet(out string shtName)
		{
			string proc = "ADD A SHEET - CHANGE LAST ID";

			wbkBeginTest(proc);

			showLastIdStatus($"before {nameof(xDAddSheet)}");

			Sheet sht = CreateSheet();

			_xData.AddNewSheet(sht);

			shtName = sht.DsName;

			wbkEndTest(proc);

			return endValidateTest2(proc);
		}

		private bool xDDeleteSheetC(string shtName)
		{
			string proc = $"DELETE A SHEET | {shtName}";

			wbkBeginTest(proc);

			_xData.DeleteSheet(shtName);

			wbkEndTest(proc);

			return endValidateTest2(proc);
		}

		private bool xDUndoShtsLst()
		{
			string proc = "UNDO SHEETS LIST";

			if (!_xData.UndoBtnShtsLstStatus)
			{
				R.AddRoute( "*** CANNOT undo sheets list (fail)", 0, -1);
				R.WriteLine("*** CANNOT undo sheets list (fail)");
				return false;
			}

			R.AddRoute( "*** CAN undo sheets list (correct)", 0, -1);
			R.WriteLine("\n*** CAN undo sheets list (correct)\n");

			wbkBeginTest(proc);

			showLastIdStatus($"before {nameof(xDAddSheet)}");

			_xData.ShtsLstUndoChgsAll();

			wbkEndTest(proc);

			return endValidateTest2(proc);
		}

		private bool xDApplyShtsLst()
		{
			string proc = "APPLY SHEETS LIST";

			if (!_xData.ApplyBtnShtsLstStatus)
			{
				R.AddRoute( "*** CANNOT apply sheets list (fail)", 0, -1);
				R.WriteLine("*** CANNOT apply sheets list (fail)");
				return false;
			}

			R.AddRoute( "*** CAN apply sheets list (correct)", 0, -1);
			R.WriteLine("\n*** CAN apply sheets list (correct)\n");

			wbkBeginTest(proc);

			showLastIdStatus($"before {nameof(xDAddSheet)}");

			_xData.ShtsLstApplyChgsAll();

			wbkEndTest(proc);

			return endValidateTest2(proc);
		}

		private bool xDUnDeleteSheet(string shtName)
		{
			string proc = $"UN-DELETE A SHEET | {shtName}";

			wbkBeginTest(proc);

			_xData.UnDeleteSheet(shtName);

			wbkEndTest(proc);

			return endValidateTest2(proc);
		}

