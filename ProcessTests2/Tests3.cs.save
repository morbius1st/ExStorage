		private string test302bDesc = "change user field (desc, last id, name mod) undo all";
		public bool Test302B(string testId)
		{
			// remember to register routine
			R.AddRouteEnter();
			bool result = true;

			tstId = testId;

			tests = [_V.WbkDescChanged_alt1, _V.WbkLastIdChanged_g, 
				_V.WbkNameModChanged_alt2, _V.WbkDescChgUndo];

			wbkStartTest(test302aDesc);

			result &= wbkChgDesc(FAUX_DESCRIPTION_ALT1);

			result &= wbkChgLastId(FAUX_LAST_ID_UPD_G);

			result &= wbkChgNameMod(FAUX_USER_NAME_ALT2);

			if (!wbkCanUndo(result)) return false;

			result &= wbkUndoAll();

			wbkShowTestCompletionResult( result);

			R.AddRouteExit();

			return result;
		}


