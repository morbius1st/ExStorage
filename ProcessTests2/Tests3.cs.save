		/* 33x compound change user field, add sheets */

		private string test331aDesc = "change user field (desc), add 1 sheet";
		public bool Test331A(string testId)
		{
			// remember to register routine
			R.AddRouteEnter();
			bool result = true;

			tstId = testId;

			doingShtLst = true;

			tests = [_V.WbkDescChanged_alt1, _V.XdAddFirstSheetPlusDesc];

			wbkStartTest(test331aDesc);

			result &= wbkChgDesc(FAUX_DESCRIPTION_ALT1);

			result &= xDAddSheet(out _);

			wbkShowTestCompletionResult( result);

			R.AddRouteExit();

			return result;
		}

		// this is an invalid test - workbook undo all is not allowed after 
		// sheet(s) are added
		private string test331bDesc = "change user field (desc), add 1 sheet, undo wbk all";
		public bool Test331B(string testId)
		{
			// remember to register routine
			R.AddRouteEnter();
			bool result = true;

			tstId = testId;

			doingShtLst = true;

			tests = [_V.WbkDescChanged_alt1, _V.XdAddFirstSheetPlusDesc, 
				_V.WbkDescChgUndoAfterAddSheet];

			wbkStartTest(test331bDesc);

			result &= wbkChgDesc(FAUX_DESCRIPTION_ALT1);

			result &= xDAddSheet(out _);

			if (!wbkCanUndo(result)) return true;

			result &= wbkUndoAll();

			wbkShowTestCompletionResult( result);

			R.AddRouteExit();

			return result;
		}

		// this is an invalid test - workbook apply all is not allowed after 
		// sheet(s) are added
		private string test331cDesc = "change user field (desc), add 1 sheet, apply wbk all";
		public bool Test331C(string testId)
		{
			// remember to register routine
			R.AddRouteEnter();
			bool result = true;

			tstId = testId;

			doingShtLst = true;

			tests = [_V.WbkDescChanged_alt1, _V.XdAddFirstSheetPlusDesc, 
				_V.WbkDescChgApplyAfterAddSheet];

			wbkStartTest(test331cDesc);

			result &= wbkChgDesc(FAUX_DESCRIPTION_ALT1);

			result &= xDAddSheet(out _);

			if (!wbkCanApply(result)) return true;

			result &= wbkApplyAll();

			wbkShowTestCompletionResult( result);

			R.AddRouteExit();

			return result;
		}

