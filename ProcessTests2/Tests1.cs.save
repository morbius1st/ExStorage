		private bool chgNameModByUser(out bool namesMatch)
		{
			string proc = "CHANGE NAME MOD";

			wbkBeginTest(proc);

			string nameBefore = _wbk.NameModified;

			_wbk.NameModified = FauxUserName;

			if (nameBefore == _wbk.NameModified)
			{
				R.WriteLine($"\tname modified match | {nameBefore} vs {_wbk.NameModified}");

				namesMatch = true;
			}
			else
			{
				R.WriteLine($"\tname modified does not match | {nameBefore} vs {_wbk.NameModified}");

				namesMatch = false;
			}

			return wbkEndTest(proc);
		}

		private bool undoNameMod()
		{
			string proc = "UNDO CHANGE NAME MOD";
			
			_wbk.UndoChange(_wbk.NameModifiedField, false);

			return wbkEndTest(proc);
		}

		private void chgLastIdUser(string title)
		{
			R.WriteLineAnyway($"[ {tstAnsIdx,-3} ] BEGIN CHANGE LAST ID (user)");
			R.NewLine();

			R.AddRouteEnter();
			_wbk.LastId = "BAAA";

			R.AddRouteExit();

			R.WriteLine("\nAFTER CHANGE LAST ID (user)");

			wbkShowTestStatus(title);

			R.ShowRoute();
		}

		private void undoChgLastIdUser(string title)
		{
			R.WriteLineAnyway($"[ {tstAnsIdx,-3} ] BEGIN UNDO LAST ID (user) - do not use this");
			R.NewLine();

			R.StartRoute();

			_wbk.UndoChange(_wbk.LastIdField, false);

			R.WriteLine("\nAFTER UNDO LAST ID (user)");

			wbkShowTestStatus(title);

			R.ShowRoute();
		}


		/* show / utility routines */

		private void wbkStartTest(string desc)
		{
			string nametst = "";
			string nameWbk = "";
			bool nameStatus;
			string nameResult = "";

			R.WriteLineAnyway($"{tstTitle} START | {desc}");
			// ShowWbk.ShowWorkbook();
			ShowWbk.ShowWorkbookFields();

			if (tstNameModIdx == 0)
			{
				nametst = tstNamMod[tstNameModIdx++];
				nameWbk = _wbk.NameModified;
				nameStatus = nametst.Equals(nameWbk);
				nameResult = nameStatus ? "they MATCH" : "they do NOT match";

				R.WriteLine($"\n\tdoes actual {nameWbk} equal test {nametst}? {nameResult}");
			}

			R.NewLineAnyway();
		}

		private void wbkBeginTest(string proc)
		{
			R.WriteLine($"****************************");
			R.WriteAnyway($"{$"[ {tstAnsIdx} ]",-5} {tstTitle} | ");
			R.Write($"BEGIN ");
			R.WriteAnyway($"{proc} ");
			R.NewLine();
			R.NewLine();
			R.StartRoute();
			R.AddRouteEnter();
		}

		private bool wbkEndTest(string proc)
		{
			R.AddRouteExit();
			R.WriteLine($"\nAFTER {proc}");
			wbkShowTestStatus(tstTitle);
			R.ShowRoute();

			return showWbkValidateStatus();
		}

