		public bool Test23C(string testId, string desc = "wbk change desc / mod lastId by add sheet / change status => shts lst undo all() => wbk apply all ()")
		{
			bool result = true;

			tstTitle = $"TEST{testId}";
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			wbkStartTest(desc);

			// A
			result &= wbkChgDesc();

			R.NewLineAnyway();

			// B
			result &= xdChgLastIdByAddSht(out _);

			R.NewLineAnyway();

			// C
			result &= chgStatus();

			R.NewLineAnyway();

			// D
			result &= shtsLstUndoAll();

			R.NewLineAnyway();

			// E
			if (_wbk.ApplyBtnStatus)
			{
				R.WriteLine("\t*** APPLY changes all *** should happen");
				result &= wbkApplyAll();
			}
			else
			{
				// this should happen
				R.WriteLineAnyway("\n*** CANNOT apply changes all\n*** should happen\n****\n");
				result = true;
			}

			R.NewLineAnyway();

			wbkShowTestResult(result);

			return result;
		}

