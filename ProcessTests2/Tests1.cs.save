		public bool Test1E(string testId, string desc = "wbk change name mod, undo same")
		{
			bool result = true;

			tstTitle = $"TEST{testId}";
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			tstNameModIdx = 0;
			tstNamMod = _tstAnsNameMod[tstTitle];

			wbkStartTest(desc);

			bool namesMatch;

			UseAlt2UserName();

			result &= chgNameModByUser(out namesMatch);

			UseFauxUserName();

			result &= !namesMatch;

			R.NewLineAnyway();

			result &= undoNameMod();

			R.NewLineAnyway();

			wbkShowTestResult(result);

			return result;
		}


		public bool Test2B(string desc = "wbk change status / mod lastId by add sheet => undo each in non-matching order")
		{
			bool result = true;

			string title = "TEST2B";
			bool[,] tst = _tstAnswers[title];
			int ansIdx = 0;

			tstTitle = title;
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			wbkStartTest(desc);

			// A
			result &= wbkChgDesc();
			tstAnsIdx = ++ansIdx;


			R.NewLineAnyway();

			// B
			result &= xdChgLastIdByAddSht(out _);
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			// C
			result &= chgStatus();
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			undoChgStatus(title);

			// D
			result &= showWbkValidateStatus(title, tst, ansIdx, true);
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			// E
			result &= shtsLstUndoAll();
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			// F
			result &= wbkUndoChgDesc();

			wbkShowTestResult(result);

			return result;
		}

		public bool Test2C(string desc = "wbk change status / mod lastId by add sheet => wbk apply all () => fail (good)")
		{
			bool result = true;

			tstTitle = "TEST2C";
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			wbkStartTest(desc);

			// A
			result &= wbkChgDesc();

			R.NewLineAnyway();

			// B
			result &= xdChgLastIdByAddSht(out _);

			R.NewLineAnyway();

			// C
			result &= chgStatus();

			// D
			if (_wbk.ApplyBtnStatus)
			{
				R.WriteLineAnyway("*** APPLY changes all - should not happen - fail\n");
				result = false;
			}
			else
			{
				// this should happen
				R.WriteLineAnyway("*** CANNOT apply changes all\n");
				// final result -s per the above
				// because &= with true does not change anything
				// and setting to true is not correct
			}
			
			wbkShowTestResult(result);

			return result;
		}

