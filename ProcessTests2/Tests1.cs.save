		private void initCreateSheets()
		{
			R.WriteLine("*******  init create sheets Test1 *******");

			ExStorConstFaux.UseFauxUserName();

			_xData.AddSheetPreInit(CreateSheetStealth());
			_sht = CreateSheetStealth();

			_xData.AddSheetPreInit(_sht);

			_xData.SelectSheet = _sht.DsName;

			_xData.AddSheetPreInit(CreateSheetStealth());

			_wbk.LastIdField.ApplyChg();

			ExStorConstFaux.UseAltUserName();
		}

		private WorkBook _wbk => _xData.WorkBook;


		/* wbk public */

		// primary level 1 test

		public bool Test1A(string desc = "wbk change desc, undo same")
		{
			bool result = true;

			tstTitle = "TEST1A";
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			wbkStartTest(desc);

			result &= wbkChgDesc();

			R.NewLineAnyway();

			result &= wbkUndoChgDesc();

			R.NewLineAnyway();

			wbkShowTestResult(result);

			return result;
		}

		public bool Test1B(string desc = "wbk change lastId (user) => undo each in non-matching order")
		{
			bool result = true;
			bool showShtLst = false;

			string title = "TEST1B";

			bool[,] tst = _tstAnswers[title];
			int ansIdx = 0;

			tstTitle = title;
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			wbkStartTest(desc);

			// A
			result &= wbkChgDesc();
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			chgLastIdUser(title);
			// B
			result &= showWbkValidateStatus(title, tst, ansIdx, showShtLst);
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			// C
			result &= chgStatus();
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			undoChgStatus(title);
			// D
			result &= showWbkValidateStatus(title, tst, ansIdx, showShtLst);
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			// E
			result &= wbkUndoChgDesc();
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			undoChgLastIdUser(title);
			// F
			result &= showWbkValidateStatus(title, tst, ansIdx, showShtLst);

			R.NewLineAnyway();

			wbkShowTestResult(result);

			return result;
		}

		public bool Test1C(string desc = "wbk change lastId (user) => apply all ()")
		{
			bool result = true;
			bool showShtLst = false;

			string title = "TEST1C";

			bool[,] tst = _tstAnswers[title];
			int ansIdx = 0;


			tstTitle = title;
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			wbkStartTest(desc);

			// A
			result &= wbkChgDesc();
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			chgLastIdUser(title);

			// B
			result &= showWbkValidateStatus(title, tst, ansIdx, showShtLst);
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			// C
			result &= chgStatus();
			tstAnsIdx = ++ansIdx;

			R.NewLineAnyway();

			// D
			if (_wbk.ApplyBtnStatus)
			{
				R.WriteLine("*** APPLY changes all");
				result &= wbkApplyAll();
			}
			else
			{
				R.WriteLine("*** CANNOT apply changes all");
				result = false;
			}

			R.NewLineAnyway();

			wbkShowTestResult(result);

			return result;
		}

