		// level 2 tests, two subjects, oen operation

		public bool Test21A(string testId, string desc = "sht list & LastId - add a sheet, delete a sheet, sht list undo all")
		{
			bool result = true;

			tstTitle = $"TEST{testId}";
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			wbkStartTest(desc);

			// A - add a sheet
			result &= xdChgLastIdByAddSht(out _);

			R.NewLineAnyway();

			// B - delete a different sheet
			result &= xdDeleteSht("CsCells_SHT_AAAC_v1_10");

			R.NewLineAnyway();

			// C - undo all
			result &= shtsLstUndoAll();

			R.NewLineAnyway();

			wbkShowTestResult(result);

			return result;
		}

		public bool Test21B(string testId, string desc = "sht list & LastId - add a sheets, delete sheets, sht list undo all")
		{
