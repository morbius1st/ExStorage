		public bool Test24C(string testId, string desc = "change name modified, add sheet, apply sheets, apply all => fail, name mod taken over, apply button not enabled")
		{
			bool result = true;
			bool namesMatch;

			tstTitle = $"TEST{testId}";
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			tstNameModIdx = 0;
			tstNamMod = _tstAnsNameMod[tstTitle];

			wbkStartTest(desc);

			// A
			result &= chgNameModByUser(out namesMatch);
			// names matching is a fail
			// flip status to get the correct result
			result &= !namesMatch;

			R.NewLineAnyway();

			ExStorConstFaux.UseFauxUserName();

			// B
			result &= xdChgLastIdByAddSht(out _);

			ExStorConstFaux.UseAltUserName();

			R.NewLineAnyway();

			// C
			result &= shtLstApplyAll();

			R.NewLineAnyway();

			// D
			if (_wbk.ApplyBtnStatus)
			{
				R.WriteLineAnyway("*** can APPLY changes all - this should not happen - fail");
				result = false;
			}
			else
			{
				// this should happen
				R.WriteLineAnyway("*** CANNOT apply changes all - this should happen - correct\n");
			}

			

			wbkShowTestResult(result);

			return result;
		}

		public bool Test24D(string testId, string desc = "change name modified, add sheet, undo sheets, apply all => should work")
		{
			bool result = true;
			bool namesMatch;

			tstTitle = $"TEST{testId}";
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			tstNameModIdx = 0;
			tstNamMod = _tstAnsNameMod[tstTitle];

			wbkStartTest(desc);

			// A
			result &= chgNameModByUser(out namesMatch);
			// names matching is a fail
			// flip status to get the correct result
			result &= !namesMatch;

			R.NewLineAnyway();

			// B
			result &= xdChgLastIdByAddSht(out _);

			R.NewLineAnyway();

			// C
			result &= shtsLstUndoAll();

			R.NewLineAnyway();

			if (_wbk.ApplyBtnStatus)
			{
				R.WriteLineAnyway("*** can APPLY changes all - this NOT should happen - fail");

				// D
				result = false;
			}
			else
			{
				// this should happen
				R.WriteLineAnyway("*** CANNOT apply changes all - this should happen - correct\n");

			}

			wbkShowTestResult(result);

			return result;
		}

