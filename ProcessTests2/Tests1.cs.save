		private String enableDisable(bool which)
		{
			return which ? "ENABLED" : "DISABLED";
		}


		private void wbkShowTestResult(bool result)
		{
			string r = result ? "WORKED" : "FAIL";

			R.WriteLine("\n**********");
			R.WriteLine($"{r}");
			R.WriteLine("****************************\n");
		}

		private bool showWbkValidateStatus()
		{
			return showWbkValidateStatus(tstTitle, tstAns, tstAnsIdx++, shwShtLst);
		}

		private bool showWbkValidateStatus(string title, bool[,] a, int idx, bool shtList)
		{
			bool status = true;

			string w;
			string wbkA;
			string wbkU;
			string shtLstA = "";
			string shtLstU = "";
			string nametst = "";
			string nameWbk = "";
			bool nameStatus;
			string nameResult = "";

			status &= evalStatus(_wbk.IsModifiedExo, a[idx, 0], out w);
			status &= evalStatus(_wbk.ApplyBtnStatus, a[idx, 1], out wbkA);
			status &= evalStatus(_wbk.UndoBtnStatus, a[idx, 2], out wbkU);

			if (shtList)
			{
				status &= evalStatus(_xData.ApplyBtnShtsLstStatus, a[idx, 3], out shtLstA);
				status &= evalStatus(_xData.UndoBtnShtsLstStatus, a[idx, 4], out shtLstU);
			}

			if (tstNameModIdx >=0)
			{
				nametst = tstNamMod[tstNameModIdx++];
				nameWbk = _wbk.NameModified;
				nameStatus = nametst.Equals(nameWbk);
				nameResult = nameStatus ? "they MATCH" : "they do NOT match";
				status &= nameStatus;
			}

			string i = $"[ {idx} ]";

			string s = status ? "WORKED" : "FAIL";

			R.WriteLine("**********");
			R.WriteLine($"{title,-16} {i,-6}| WORKBOOK stat {w} [{a[idx, 0]}] ");
			R.WriteAnyway($"status {s,-15}");
			R.Write($" | WORKBOOK buttons | apply {wbkA} [should be {enableDisable(a[idx, 1])}] | undo {wbkU} [should be {enableDisable(a[idx, 2])}]");
			R.NewLineAnyway();
			if (shtList) R.WriteLine($"{" ".Repeat(23)}| SHTS LST buttons | apply {shtLstA} [should be {enableDisable(a[idx, 3])}] | undo {shtLstU} [should be {enableDisable(a[idx, 4])}]");
			if (tstNameModIdx >= 0) R.WriteLine($"{" ".Repeat(23)}| does actual {nameWbk} equal test {nametst}? {nameResult}");
			R.WriteLine("**********");

			return status;
		}

		private void showLastIdStatus(string location)
		{
			string status = _xData.WorkBook.LastIdField.IsDirty() ? "is Dirty" : "is Clean";

			R.WriteLine($"\n\t*** {location} | LastId | [ {_xData.WorkBook.LastId} ] | status [ {status} ] | chg src id [ {_xData.WorkBook.LastIdField.ChgSrc} ]\n");
		}

		private void showShtLst()
		{
			if (!shwShtLst) return;

			ShowWbk.ShowShtsLst();

			R.NewLine();
		}

		private void showWbkFieldsOverride()
		{
			if (!ShowWbkOverRideControl) return;

			bool temp = R.RunSilent;

			R.RunSilent = false;

			ShowWbk.ShowWorkbookFields();

			R.RunSilent = temp;
		}

		private bool evalStatus(bool value, bool tst, out string answer)
		{
			if (value == tst)
			{
				answer = "MATCH";
				return true;
			}

			answer = "FAIL";
			return false;
		}

		private void wbkShowTestStatus(string title)
		{
			R.NewLine();

			showShtLst();

			showWbkFieldsOverride();

			ShowWbk.wbkUiStatus($"\t{title} END  ", shwShtLst);
			R.NewLine();
		}


		/* sht private */

		// private void addSheet()
		// {
		// 	_xData.AddNewSheet(createSheet());
		// }

		public Sheet CreateSheet()
		{
			R.AddRouteEnter();

			Sheet sht = Sheet.CreateSheet(_exid.CreateShtDsName(_wbk.GetId()),
				new ($"path:\\file{shtIdx}.xls", $"no sheet name {shtIdx}"));

			sht.SetTrackChanges();

			shtIdx++;

			R.AddRouteExit();

			return sht;
		}

		public Sheet CreateSheetStealth()
		{
			Sheet sht = Sheet.CreateSheet(_exid.CreateShtDsName(_wbk.GetIdStealth()),
				new ($"path:\\file{shtIdx}.xls", $"no sheet name {shtIdx}"));

			sht.SetTrackChanges();

			shtIdx++;

			return sht;
		}

		private bool shtValidateStatus(bool[,] a, int idx, bool famList)
		{
			bool status = true;

			string w;
			string shtA;
			string shtU;
			// string famLstA;
			string famLstU;

			string famLst = "";

			status &= evalStatus(_sht.IsModifiedExo, a[idx, 0], out w);
			status &= evalStatus(_sht.ApplyBtnStatus, a[idx, 1], out shtA);
			status &= evalStatus(_sht.UndoBtnStatus, a[idx, 2], out shtU);

			if (famList)
			{
				// cannot "apply changes" these are automatically done
				// but can undo changes
				// status &= evalStatus(sht.IsModifiedFamList, a[idx, 3], out famLstA);
				status &= evalStatus(_xData.UndoBtnShtsLstStatus, a[idx, 4], out famLstU);
				famLst = $"FAMILY LST buttons | undo {famLstU} [{a[idx, 4]}]";
			}

			string s = status ? "WORKED" : "FAIL";

			R.WriteLine("**********");
			R.WriteLineAnyway($"==> {s} | sht stat {w} [{a[idx, 0]}] | SHEET buttons | apply {shtA} [{a[idx, 1]}] | undo {shtU} [{a[idx, 2]}] | {famLst}");
			R.WriteLine("**********");

			return status;
		}

		private void shtShowTestStatus(string title)
		{
			ShowSht.ShowSheet();
			R.WriteLine(ShowSht.ChangeStatus($"\n\t{title} END  "));
			ShowSht.shtUiStatus($"\t{title} END  ");
			R.NewLine();
		}

		private void shtShowFieldsOverride(bool yes)
		{
			if (!yes) return;

			bool temp = R.RunSilent;

			R.RunSilent = false;

			ShowSht.ShowSheetFields();

			R.RunSilent = temp;
		}

		/* sheet operations*/

		private bool shtChgDesc()
		{
			string proc = "CHANGE DESC";

			wbkBeginTest(proc);

			_sht.Desc = "new value";

			return wbkEndTest(proc);
		}

		private bool shtUndoChgDesc()
		{
			string proc = "UNDO CHANGE DESC";

			wbkBeginTest(proc);

			_xData.CurrentSheet!.UndoChange(_xData.CurrentSheet.DescField, false);

			return wbkEndTest(proc);
		}

		private void shtChgXlFilePath(string title)
		{
			R.WriteLineAnyway("BEGIN CHG XL FILE PATH");
			R.NewLine();

			R.StartRoute();

			_sht.XlFilePath = "this is a new file path";

			R.WriteLine("\nAFTER CHG XL FILE PATH");

			shtShowTestStatus(title);

			R.ShowRoute();
		}

		private void shtChgByAddFamAndType(string title)
		{
			R.WriteLineAnyway("BEGIN ADD FAM AND TYPE");
			R.NewLine();

			R.StartRoute();

			_sht.AddFamAndType("family name", "type name", "properties");

			R.WriteLine("\nAFTER ADD FAM AND TYPE");

			shtShowTestStatus(title);

			R.ShowRoute();
		}

		private void shtApplyAll(string title)
		{
			R.WriteLineAnyway("BEGIN SHEET APPLY ALL");
			R.NewLine();

			R.StartRoute();

			_sht.ApplyChangesAll();

			// xData.CurrSheetApplyChgs(SourceId.SI_SRC);

			R.WriteLine("\nAFTER SHEET APPLY ALL");

			shtShowTestStatus(title);

			R.ShowRoute();
		}

		/* sheet show / utility ops*/

		private void shtStartTest(string desc)
		{
			string nametst = "";
			string nameWbk = "";
			bool nameStatus;
			string nameResult = "";

			R.WriteLineAnyway($"{tstTitle} START | {desc}");
			// ShowWbk.ShowWorkbook();

			if (tstNameModIdx == 0)
			{
				nametst = tstNamMod[tstNameModIdx++];
				nameWbk = _wbk.NameModified;
				nameStatus = nametst.Equals(nameWbk);
				nameResult = nameStatus ? "they MATCH" : "they do NOT match";

				R.WriteLine($"\n\tdoes actual {nameWbk} equal test {nametst}? {nameResult}");
			}

			R.NewLineAnyway();
		}


