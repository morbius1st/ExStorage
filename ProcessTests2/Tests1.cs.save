		/* general */

		public void Reset()
		{
			
			R.WriteLine("\n****\nTEST1 perform complete date RESET\n****\n");

			ExStorData.Instance.ResetAll();

			init();

			initCreateSheets();

		}

		private void showProgress(string title, bool status, string suffixT, string suffixF)
		{
			string s = status ? "WORKED" : "FAIL";
			string suffix = status ? suffixT : suffixF;

			R.WriteLine("**********");
			R.WriteAnyway($"{title} | status {s} | {suffix}\n");
			R.WriteLine("**********");
		}



		/* wbk private */


		/* modification methods */

		/* workbook primary methods */

		private bool wbkApplyAll()
		{
			string proc = "WORKBOOK APPLY ALL";

			wbkBeginTest(proc);

			_wbk.ApplyChangesAll();

			return wbkEndTest(proc);
		}

		private bool wbkUndoAll()
		{
			string proc = "WORKBOOK UNDO ALL";

			wbkBeginTest(proc);

			_wbk.UndoChangesAll();

			return wbkEndTest(proc);
		}

		/* sheets list  primary methods */

		private bool shtLstApplyAll()
		{
			string proc = "SHTS LST APPLY ALL";

			wbkBeginTest(proc);

			_xData.ShtsLstApplyChgsAll();

			return wbkEndTest(proc);
		}

		private bool shtsLstUndoAll()
		{
			string proc = "SHEETS LIST UNDO ALL";

			wbkBeginTest(proc);

			showLastIdStatus($"before {nameof(shtsLstUndoAll)}");

			_xData.ShtsLstUndoChgsAll();

			return wbkEndTest(proc);
		}

		/* general modification methods */


		private bool wbkChgDesc()
		{
			string proc = "CHANGE DESC";

			wbkBeginTest(proc);

			_wbk.Desc = "new value";

			return wbkEndTest(proc);
		}

		private bool wbkUndoChgDesc()
		{
			string proc = "UNDO DESC";

			wbkBeginTest(proc);

			_wbk.UndoChange(_wbk.DescField, false);

			return wbkEndTest(proc);
		}

		private bool xdChgLastIdByAddSht(out string shtName)
		{
			string proc = "ADD SHEET - CHANGE LAST ID (alt src)";

			wbkBeginTest(proc);

			showLastIdStatus($"before {nameof(xdChgLastIdByAddSht)}");

			Sheet sht = CreateSheet();

			_xData.AddNewSheet(sht);

			shtName = sht.DsName;

			return wbkEndTest(proc);
		}

		private bool xdDeleteSht(string name = "")
		{
			string proc = "REMOVE SHT FROM SHTS LST";

			wbkBeginTest(proc);

			showLastIdStatus($"before {nameof(xdDeleteSht)}");

			if (name.IsVoid())
			{
				_xData.DeleteSheet("CsCells_SHT_AAAC_v1_10");
			}
			else
			{
				_xData.DeleteSheet(name);
			}

			return wbkEndTest(proc);
		}

		private bool chgStatus()
		{
			string proc = "CHANGE STATUS";

			wbkBeginTest(proc);

			_wbk.Status = ActivateStatus.AS_INACTIVE;

			return wbkEndTest(proc);
		}

		private void undoChgStatus(string title)
		{
			R.WriteLineAnyway($"[ {tstAnsIdx,-3} ] BEGIN UNDO CHG STATUS");
			R.NewLine();

			R.AddRouteEnter();
			_wbk.UndoChange(_wbk.StatusField, false);
			R.AddRouteExit();

			R.WriteLine("\nAFTER UNDO CHG STATUS");

			wbkShowTestStatus(title);

			R.ShowRoute();
		}


