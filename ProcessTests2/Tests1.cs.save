		// 43A change user name, add sheet, add sheet, apply sht lst, apply wkb disabled
		// 44A add sheet, add sheet, apply sht lst, change user name, apply wkb


		public bool Test41A(string testId, string desc = "add sheet, add sheet, change user name (does not work), apply sht lst, apply wkb disabled")
		{
			bool result = true;
			bool namesMatch;

			tstTitle = $"TEST{testId}";
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			tstNameModIdx = 0;
			tstNamMod = _tstAnsNameMod[tstTitle];

			wbkStartTest(desc);

			result &= xdChgLastIdByAddSht(out _);

			R.NewLineAnyway();

			result &= xdChgLastIdByAddSht(out _);

			R.NewLineAnyway();

			// UseFauxUserName();

			// the correct test is whether editing of name mod is allowed
			// this will return true if the field can be edited - which is not good
			// flip value for this test routine

			bool answer = canEditNameModified();
			result &= !answer;

			// {
			// 	result = false;
			// 	// R.WriteLineAnyway("*** can change name modified - this NOT should happen - fail");
			// //
			// // }
			// // else
			// // {
			// // 	// this should happen
			// // 	R.WriteLineAnyway("*** CANNOT change name modified - this should happen - correct\n");
			// }

			showProgress("MODIFY name modified", answer, "this is a fail", "this is correct");


			// // changing the name will not work as the current
			// // chg src is higher precident - so the
			// // before / after names will match
			// result &= chgNameModByUser(out namesMatch);
			//
			// // matching names is correct
			// result &= namesMatch;

			// UseAltUserName();

			R.NewLineAnyway();

			result &= shtsLstUndoAll();

			R.NewLineAnyway();

			if (_wbk.ApplyBtnStatus)
			{
				R.WriteLineAnyway("*** can APPLY changes all - this NOT should happen - fail");

				result = false;
			}
			else
			{
				// this should happen
				R.WriteLineAnyway("*** CANNOT apply changes all - this should happen - correct\n");
			}

			wbkShowTestResult(result);

			return result;
		}

		public bool Test42A(string testId, string desc = "add sheet, change user name (does not work), add sheet, apply sht lst, apply wkb disabled")
		{
			bool result = true;
			bool namesMatch;

			tstTitle = $"TEST{testId}";
			tstAns = _tstAnswers[tstTitle];
			shwShtLst = true;
			tstAnsIdx = 0;

			tstNameModIdx = 0;
			tstNamMod = _tstAnsNameMod[tstTitle];

			wbkStartTest(desc);

			result &= xdChgLastIdByAddSht(out _);

			R.NewLineAnyway();

			// the correct test is whether editing of name mod is allowed
			// this will return true if the field can be edited - which is not good
			// flip value for this test routine

			bool answer = canEditNameModified();
			result &= !answer;

			showProgress("MODIFY name modified", answer, "this is a fail", "this is correct");

			R.NewLineAnyway();

			result &= xdChgLastIdByAddSht(out _);

			R.NewLineAnyway();

			result &= shtsLstUndoAll();

			R.NewLineAnyway();

			if (_wbk.ApplyBtnStatus)
			{
				R.WriteLineAnyway("*** can APPLY changes all - this NOT should happen - fail");

				result = false;
			}
			else
			{
				// this should happen
				R.WriteLineAnyway("*** CANNOT apply changes all - this should happen - correct\n");
			}

			wbkShowTestResult(result);

			return result;
		}




